from typing import Any
from . import tl
from .models import Account, Chat, Message, User

async def accounts() -> list[Account]: ...
async def current_chat(account: Account | str) -> Chat | None: ...
async def get_chat(account: Account | str, chat_id: int) -> Chat: ...
async def get_user(account: Account | str, user_id: int) -> User: ...
async def get_loaded_message(chat: Chat, message_id: int) -> Message | None: ...
async def get_message(chat: Chat, message_id: int) -> Message | None: ...
async def history(chat: Chat, *, limit: int = 50, offset_id: int = 0) -> list[Message]: ...
async def send_message(chat: Chat, text: str, *, reply_to: int | None = None, silent: bool = False, no_webpage: bool = False) -> tl.TLObject: ...
async def edit_message(chat: Chat, message_id: int, text: str) -> tl.TLObject: ...
async def delete_messages(chat: Chat, message_ids: list[int], *, revoke: bool = True) -> tl.TLObject: ...
async def forward_messages(source: Chat, target: Chat, message_ids: list[int], *, silent: bool = False) -> tl.TLObject: ...
async def rpc(account: Account | str, request: tl.TLObject, *, dc_id: int = 0, timeout: int = 60) -> Any: ...
