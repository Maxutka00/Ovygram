from collections.abc import Callable, Iterable
from typing import Any, Literal

from .models import Account, Chat, Message

Width = int | Literal["fit"] | None
Command = dict[str, Any]
Handler = Callable[..., Any]

class ObjectDestroyed(RuntimeError): ...

class Node:
    id: str
    props: dict[str, Any]
    handlers: dict[str, Handler]
    children: tuple[Node, ...]
    def to_json(self) -> dict[str, Any]: ...
    def walk(self) -> Iterable[Node]: ...

class Column(Node):
    def __init__(self, *children: Node | str, width: Width = None, stretch: int | None = None) -> None: ...

class Row(Node):
    def __init__(self, *children: Node | str, align: Literal["top", "center", "bottom"] = "center",
                 spacing: int = 8, width: Width = None, stretch: int | None = None) -> None: ...

class Text(Node):
    def __init__(self, text: Any, align: Literal["left", "center", "right"] = "left",
                 width: Width = None, stretch: int | None = None) -> None: ...

class Button(Node):
    def __init__(self, text: Any, on_click: Callable[[], Any] | None = None,
                 width: Width = None, stretch: int | None = None) -> None: ...

class Input(Node):
    def __init__(self, text: str = "", placeholder: str = "", on_change: Callable[[str], Any] | None = None,
                 width: Width = None, stretch: int | None = None) -> None: ...

class Switch(Node):
    def __init__(self, text: Any, value: bool = False, on_toggle: Callable[[bool], Any] | None = None,
                 width: Width = None, stretch: int | None = None) -> None: ...

class Image(Node):
    def __init__(self, path: str, height: int = 0, width: Width = None, stretch: int | None = None) -> None: ...

class Spacer(Node):
    def __init__(self, height: int, width: Width = None, stretch: int | None = None) -> None: ...

class Canvas(Node):
    def __init__(self, height: int, commands: Iterable[Command] = (),
                 on_click: Callable[[int, int], Any] | None = None,
                 width: Width = None, stretch: int | None = None) -> None: ...

def fill_rect(x: float, y: float, width: float, height: float, color: str, radius: float = 0) -> Command: ...
def line(x1: float, y1: float, x2: float, y2: float, color: str, width: float = 1) -> Command: ...
def ellipse(x: float, y: float, width: float, height: float, color: str) -> Command: ...
def text(x: float, y: float, value: Any, color: str, size: int = 13) -> Command: ...

class Surface:
    kind: str
    id: str
    content: Node
    title: str
    closed: bool
    on_close: Callable[[], Any] | None
    def __init__(self, content: Node | str, title: str = "", width: int = 0, height: int = 0,
                 on_close: Callable[[], Any] | None = None) -> None: ...
    def show(self) -> Surface: ...
    def update(self, node: Node, **props: Any) -> None: ...
    def draw(self, canvas: Canvas, commands: Iterable[Command]) -> None: ...
    def close(self) -> None: ...

class Dialog(Surface): ...

class Window(Surface):
    def __init__(self, content: Node | str, title: str = "", width: int = 420, height: int = 480,
                 on_close: Callable[[], Any] | None = None) -> None: ...

class ChatBar(Surface):
    def __init__(self, chat: Chat, content: Node | str, on_close: Callable[[], Any] | None = None) -> None: ...

class Section(Surface):
    def __init__(self, content: Node | str, title: str = "", on_close: Callable[[], Any] | None = None) -> None: ...

class Overlay(Surface):
    def __init__(self, target: dict[str, Any] | str, canvas: Canvas,
                 on_close: Callable[[], Any] | None = None) -> None: ...

ELEMENTS: tuple[str, ...]

class Element:
    name: str
    def hide(self) -> None: ...
    def show(self) -> None: ...
    def on_click(self, callback: Callable[[], Any], replace: bool = False) -> None: ...
    def off_click(self) -> None: ...

def element(name: str) -> Element: ...
def set_colors(colors: dict[str, str]) -> None: ...
def reset_colors() -> None: ...

class WidgetRule:
    id: str
    def remove(self) -> None: ...

async def widget_tree(depth: int = 8, root: dict[str, Any] | str | None = None) -> dict[str, Any] | None: ...
async def get_property(widget: dict[str, Any] | str, name: str) -> Any: ...
def set_property(widget: dict[str, Any] | str, name: str, value: Any) -> None: ...
def hide_widgets(**selector: Any) -> WidgetRule: ...
def on_widget_click(callback: Callable[[], Any], replace: bool = False, **selector: Any) -> WidgetRule: ...
def on_key(sequence: str, callback: Callable[[], Any], replace: bool = False,
           element: str | None = None) -> WidgetRule: ...

class ChatDecoration:
    def update(self, commands: Iterable[Command] = (), background: str | None = None) -> None: ...
    def remove(self) -> None: ...

def decorate_chat(chat: Chat | Literal["*"], commands: Iterable[Command] = (),
                  background: str | None = None, account: Account | str | None = None) -> ChatDecoration: ...
def on_compose_change(callback: Callable[[dict[str, Any]], Any]) -> WidgetRule: ...
async def compose_state() -> dict[str, Any] | None: ...
def replace_compose_text(start: int, end: int, text: str, select: bool = False) -> None: ...

class MessageDecoration:
    def update(self, commands: Iterable[Command] = (), background: str | None = None) -> None: ...
    def remove(self) -> None: ...

def decorate_message(message: Message, commands: Iterable[Command] = (),
                     background: str | None = None) -> MessageDecoration: ...

class HiddenChats:
    def remove(self) -> None: ...

def hide_chats(chats: Iterable[Chat]) -> HiddenChats: ...
async def compose_text() -> str | None: ...
def set_compose_text(text: str) -> None: ...
def insert_compose_text(text: str) -> None: ...
def set_clipboard(text: str) -> None: ...
def show_dialog(content: Node | str, title: str = "", width: int = 0,
                on_close: Callable[[], Any] | None = None) -> Dialog: ...

class MenuContext:
    account_id: str
    chat: Chat | None
    message: Message | None

def add_menu_item(menu: Literal["main", "chat", "message"], text: str,
                  callback: Callable[[MenuContext], Any],
                  kinds: Iterable[Literal["user", "chat", "channel"]] | None = None) -> WidgetRule: ...
