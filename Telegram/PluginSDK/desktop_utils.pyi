from collections.abc import Callable, Coroutine
from concurrent.futures import Future
from typing import Any, TypeVar

T = TypeVar("T")

async def run_on_ui(callback: Callable[[], T]) -> T: ...
async def run_in_background(callback: Callable[..., T], *arguments: Any, **keywords: Any) -> T: ...
def create_task(coroutine: Coroutine[Any, Any, T]) -> Future[T]: ...
def set_timer(delay: float, callback: Callable[[], Any], *, repeat: bool = False) -> Future[Any]: ...
