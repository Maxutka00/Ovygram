from collections.abc import Callable, Coroutine
from concurrent.futures import Future
from typing import Any
from desktop._runtime import Registration
from hook_utils import HookResult as HookResult, HookStrategy as HookStrategy

class BasePlugin:
    def on_plugin_load(self) -> None: ...
    def on_plugin_unload(self) -> None: ...
    def create_settings(self) -> list[Any]: ...
    def get_setting(self, key: str, default: Any = None) -> Any: ...
    def set_setting(self, key: str, value: Any) -> None: ...
    def get_account_setting(self, account_id: str, key: str, default: Any = None) -> Any: ...
    def set_account_setting(self, account_id: str, key: str, value: Any) -> None: ...
    def log(self, message: Any) -> None: ...
    def subscribe(self, event: str, callback: Callable[..., Any], priority: int = 0) -> Registration: ...
    def add_hook(self, point: str, callback: Callable[..., Any], priority: int = 0, request: str | None = None) -> Registration: ...
    def run_async(self, coroutine: Coroutine[Any, Any, Any]) -> Future[Any]: ...
