from base_plugin import BasePlugin
from desktop import ui
from ui.settings import Switch

__id__ = "desktop.top_bar"
__name__ = "Верхняя панель чата"
__version__ = "1.0.0"
__author__ = "Ovygram"
__description__ = "Скрывает кнопку звонка, перехватывает поиск и перекрашивает фон."
__platform__ = "desktop"
__desktop_sdk__ = 2
__requirements__ = []


class TopBarPlugin(BasePlugin):
    def on_plugin_load(self):
        self.apply()

    def apply(self):
        call = ui.element("chat.top_bar.call")
        if self.get_setting("hide_call", True):
            call.hide()
        else:
            call.show()
        search = ui.element("chat.top_bar.search")
        if self.get_setting("replace_search", False):
            search.on_click(self.on_search, replace=True)
        else:
            search.off_click()
        if self.get_setting("dark_background", False):
            ui.set_colors({"windowBg": "#101820", "historyComposeAreaBg": "#101820"})
        else:
            ui.reset_colors()

    def on_search(self):
        ui.show_dialog("Поиск перехвачен плагином «Верхняя панель чата».", title="Поиск")

    def create_settings(self):
        return [
            Switch("hide_call", "Скрыть кнопку звонка", True),
            Switch("replace_search", "Заменить действие кнопки поиска", False),
            Switch("dark_background", "Тёмный фон окна", False),
        ]
