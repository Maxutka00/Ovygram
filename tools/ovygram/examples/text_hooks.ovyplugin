from base_plugin import BasePlugin
from hook_utils import CANCEL, MODIFY, HookResult

__id__ = "text_hooks"
__name__ = "Обработка текста"
__version__ = "1.0.0"
__release__ = False
__author__ = "Ovygram"
__description__ = "Команда /cancel отменяется, /upper текст отправляется заглавными буквами."
__platform__ = "desktop"
__desktop_sdk__ = 2
__requirements__ = []


class TextHooksPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_hook("before_send", self.before_send, request="messages.sendMessage")

    def before_send(self, message):
        if message.text.startswith("/cancel"):
            return HookResult(CANCEL, reason="Команда /cancel отменена примером плагина.")
        if message.text.startswith("/upper "):
            message.text = message.text.removeprefix("/upper ").upper()
            return HookResult(MODIFY, message)
        return HookResult()
